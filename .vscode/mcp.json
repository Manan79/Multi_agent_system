{
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${input:github-token}"
			}
		}
	},
	"inputs": [
		{
			"type": "promptString",
			"id": "github-token",
			"description": "GitHub personal access token",
			"password": true
		}
	]
}